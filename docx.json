// Execução directa: imprime os capítulos formatados no terminal

if (require.main === module) {

  const printTable = (t) => {

    console.log(`\n[${t.number
            }: ${t.title
            }
        ]`);

    if (t.columns) console.log(t.columns.join(" | "));

    t.rows.forEach((r) => console.log(r.join(" | ")));

    console.log(`Fonte: ${t.source
        }`);

    if (t.note) console.log(`Nota: ${t.note
        }`);
    };

  const printFigure = (f) => {

    console.log(`\n[${f.number
            }: ${f.title
            } — Fonte: ${f.source
            }
        ]`);

    console.log(f.placeholder);
    };

  const printBlock = (b) => {

    if (b.label) console.log(`\n${b.label
        }`);

    if (b.paragraphs) b.paragraphs.forEach((p) => console.log(`\n${p
        }`));

    if (b.definitionList) b.definitionList.forEach((d) => console.log(`- ${d.term
        }: ${d.definition
        }`));

    if (b.list) b.list.forEach((li) => console.log(`- ${li
        }`));

    if (b.numberedList) b.numberedList.forEach((li, i) => console.log(`${i + 1
        }. ${li
        }`));

    if (b.trailingParagraphs) b.trailingParagraphs.forEach((p) => console.log(`\n${p
        }`));

    if (b.closingParagraphs) b.closingParagraphs.forEach((p) => console.log(`\n${p
        }`));

    if (b.moreParagraphs) b.moreParagraphs.forEach((p) => console.log(`\n${p
        }`));

    if (b.evenMoreParagraphs) b.evenMoreParagraphs.forEach((p) => console.log(`\n${p
        }`));

    if (b.finalParagraphs) b.finalParagraphs.forEach((p) => console.log(`\n${p
        }`));

    [
            "table",
            "tables",
            "tables2",
            "tables3",
            "tables4",
            "tables5"
        ].forEach((key) => {

      const val = b[key
            ];

      if (!val) return;

      if (Array.isArray(val)) val.forEach(printTable);

      else printTable(val);
        });

    if (b.useCaseTables) b.useCaseTables.forEach(printTable);

    if (b.figure) printFigure(b.figure);

    if (b.figure2) printFigure(b.figure2);

    if (b.figures) b.figures.forEach(printFigure);

    if (b.subsections) b.subsections.forEach(printBlock);
    };

  const printChapter = (cap) => {

    console.log(cap.chapter.toUpperCase());

    if (cap.intro) cap.intro.forEach((p) => console.log(`\n${p
        }`));

    for (const s of cap.sections) {

      console.log(`\n${s.number
            } ${s.title
            }`);

      printBlock(s);
        }
    };

  printChapter(capituloI);

  console.log("\n\n");

  printChapter(capituloII);

  console.log("\n\n");

  printChapter(capituloIII);

  console.log("\n\n");

  printChapter(capituloIV);

  console.log("\n\n");

  printChapter(capituloV);
}